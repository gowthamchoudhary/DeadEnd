# DeadEnd backend — every variable (copy to deadend_backend/.env in prod)
# (committed at repo root because dotfiles are gitignored by policy)

DEADEND_ENV=dev
DEADEND_BASE_URL=http://localhost:8000
DEADEND_WEB_ORIGIN=http://localhost:5173
DEADEND_MAX_BODY_BYTES=1000000
DEADEND_RATE_LIMIT_PER_MIN=60
DEADEND_RATE_LIMIT_IP_PER_MIN=240
DEADEND_BUDGET_DEFAULT_TOKENS=1500

# Supabase Postgres pooled connection string
DEADEND_DATABASE_URL=

# python -c "import secrets;print(secrets.token_urlsafe(32))"
DEADEND_AUTH_SECRET=

# GitHub OAuth app; callback = $DEADEND_BASE_URL/auth/callback
DEADEND_GITHUB_CLIENT_ID=
DEADEND_GITHUB_CLIENT_SECRET=

# neatlogs project key (backend Curator/Verifier/promoter tracing)
DEADEND_NEATLOGS_API_KEY=

# Entire global repo for service-account publishing
DEADEND_ENTIRE_GLOBAL_REMOTE=

# verify sandbox timeout (seconds)
DEADEND_VERIFY_WORKER_TIMEOUT_S=600

# Local runner (user machine, NOT backend): env vars only, never sent to backend
DEADEND_BACKEND=http://localhost:8000
DEADEND_TOKEN=            # per-user API token
DEADEND_TEAM=             # team_id the runner acts for
